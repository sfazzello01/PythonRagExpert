# Shared configuration for the backend judge and Esperto
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=mariadb
MYSQL_USER=laboratorio
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306
LLM_MODEL=gemma3:4b
OLLAMA_URL=http://ollama:11434
TEMPERATURE=0.0
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=codebase_expert_bgem3_v1
K=6
PREFETCH_LIMIT=20
SEMANTIC_RELEVANCE_RATIO=0.5
EMBEDDING_MAX_LENGTH=1024
MAX_MESSAGE_LENGTH=5000
MIN_MESSAGE_LENGTH=3
MODEL_LOAD_TIMEOUT=60.0
QDRANT_QUERY_TIMEOUT=30.0
LLM_INFERENCE_TIMEOUT=120.0
BASE_DIR=/app/workspace/current
BGE_M3_DEVICE=cuda
BGE_M3_USE_FP16=true
BATCH_SIZE=2
INDEX_STATE_DIR=/app/state
DENSE_MODEL_NAME=BAAI/bge-m3
SYMBOL_GRAPH_MAX_NEIGHBORS=6
SYMBOL_GRAPH_MAX_DEPTH=3
SYMBOL_GRAPH_PAGERANK_DAMPING=0.4
SYMBOL_GRAPH_PAGERANK_ITERATIONS=20
SYMBOL_GRAPH_PAGERANK_TOLERANCE=1e-6
RAG_CONTEXT_MAX_CHARS=60000
RAG_CONTEXT_MAX_SOURCES=35
INDEX_CHUNK_SIZE=1200
INDEX_CHUNK_OVERLAP=150
SUPPORTED_EXTENSIONS=.py,.yaml,.yml,.md,.txt,.html,.json,.js
SKIP_DIRS=__pycache__,.git,.pytest_cache,.mypy_cache,logs,mariadb_data,ollama_data,qdrant_data,node_modules,dist,build
INDEX_TARGET_PATHS=.
MAX_UPLOAD_MB=200

# Utilizziamo una versione slim per ridurre le dimensioni dell'immagine
FROM python:3.10-slim

# Evita la generazione dei file .pyc e assicura che i log siano visibili in tempo reale
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# 'curl' serve agli healthcheck del container; tutte le dipendenze Python hanno wheel precompilate
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copiamo solo il file dei requisiti per sfruttare la cache dei layer di Docker
COPY requirements.txt .

# Installiamo le librerie Python
RUN pip install --no-cache-dir -r requirements.txt

# Copiamo il resto del codice dell'applicazione
COPY . .

# Esponiamo la porta per FastAPI
EXPOSE 5000

# Comando per avviare l'applicazione con Uvicorn
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "5000"]
# Utilizziamo una versione slim per ridurre le dimensioni dell'immagine
FROM python:3.10-slim

# Evita la generazione dei file .pyc e assicura che i log siano visibili in tempo reale
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# 'curl' serve agli healthcheck del container; tutte le dipendenze Python hanno wheel precompilate
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 1: aggiunge PyTorch (CUDA) per indicizzare su GPU NVIDIA; usato solo dal servizio esperto_indexer
ARG INDEXER_GPU=0

# Copiamo solo i file dei requisiti per sfruttare la cache dei layer di Docker
COPY requirements.txt requirements-gpu.txt ./

# Installiamo le librerie Python; 'triton' (dipendenza di PyTorch) serve solo a torch.compile
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "$INDEXER_GPU" = "1" ]; then \
        pip install --no-cache-dir -r requirements-gpu.txt && pip uninstall -y triton; \
    fi

# Copiamo il resto del codice dell'applicazione
COPY . .

# Esponiamo la porta per FastAPI
EXPOSE 5000

# Comando per avviare l'applicazione con Uvicorn
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "5000"]
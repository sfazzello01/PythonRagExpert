# Esperto RAG Microservice Configuration
# Copy to .env and customize for your environment

# Ollama LLM Configuration
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
TEMPERATURE=0.0

# Qdrant Vector DB Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=codebase_expert_bgem3_v1

# Retrieval Hyperparameters
K=10
PREFETCH_LIMIT=20
SEMANTIC_RELEVANCE_THRESHOLD=0.0

# BGE-M3 CPU-safe indexing settings
BATCH_SIZE=2
EMBEDDING_MAX_LENGTH=1024
INDEX_STATE_DIR=/app/state
BGE_M3_DEVICE=cuda
BGE_M3_USE_FP16=true

# API Configuration
MAX_MESSAGE_LENGTH=5000
MIN_MESSAGE_LENGTH=3

# Timeout Configuration (seconds)
MODEL_LOAD_TIMEOUT=60.0
QDRANT_QUERY_TIMEOUT=30.0
LLM_INFERENCE_TIMEOUT=120.0
